# Production environment variables for LENR Sim App Frontend
# These variables are embedded at build time

# Base URL for serving the app from a subdirectory
PUBLIC_URL=/lenr-sim-app

# API endpoint (update with your production domain)
REACT_APP_API_BASE_URL=https://conscious.energy/lenr-sim-app/api
VITE_API_URL=https://conscious.energy/lenr-sim-app/api

# Logging level (error, warn, info, debug)
REACT_APP_LOG_LEVEL=warn

# Feature flags (optional)
REACT_APP_ENABLE_DEBUG_TOOLS=false
