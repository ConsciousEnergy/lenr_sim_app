[run]
source = app
omit =
    app/*/migrations/*
    app/*/tests/*
    app/__init__.py
    app/core/__init__.py
    app/core/middleware/__init__.py
    app/physics/__init__.py
    app/api/__init__.py
    app/services/__init__.py
    app/schemas/__init__.py
    app/utils/__init__.py
    app/db/__init__.py
    app/*/models/__init__.py
    app/*/routers/__init__.py
    app/*/schemas/__init__.py
    app/*/services/__init__.py
    app/*/utils/__init__.py
    app/main.py
    app/utils/debug.py
    
[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError
    raise NotImplementedError
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @overload

[html]
directory = coverage_html_report 