# LENR Simulation App - Production Environment Variables
# Copy this file to .env and update values for your deployment

# ===========================================
# Frontend Environment Variables
# ===========================================
# These are build-time variables for the React app

# Base URL for the app (subdirectory path)
PUBLIC_URL=/lenr-sim-app

# API Base URL (full URL to the API)
REACT_APP_API_BASE_URL=https://conscious.energy/lenr-sim-app/api
VITE_API_URL=https://conscious.energy/lenr-sim-app/api

# ===========================================
# Backend Environment Variables
# ===========================================
# These are runtime variables for the FastAPI backend

# Environment type: development, test, production
LENR_ENVIRONMENT=production

# Debug mode (set to false in production)
LENR_DEBUG=false

# Application info
LENR_APP_NAME=LENR_Sim_App
LENR_APP_VERSION=0.1.0

# CORS Configuration - comma-separated list of allowed origins
LENR_CORS_ORIGINS=https://conscious.energy,https://www.conscious.energy

# Logging
LENR_LOG_LEVEL=INFO
LENR_LOG_TO_FILE=true

# Performance settings
LENR_DEFAULT_TIMEOUT=60.0
LENR_MEMORY_WARNING_THRESHOLD=75.0
LENR_MEMORY_CRITICAL_THRESHOLD=90.0

# Security settings
LENR_ENABLE_RATE_LIMITING=true
LENR_RATE_LIMIT_PER_MINUTE=60
LENR_ENABLE_SECURE_HEADERS=true
LENR_ENABLE_HSTS=true
LENR_HTTPS_REDIRECT=true

# Cache settings
LENR_CACHE_ENABLED=true
LENR_CACHE_TTL_SECONDS=3600

# JWT Secret (generate a secure random string for production!)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
LENR_JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# Optional: Database URL (if using database persistence)
# LENR_DATABASE_URL=postgresql://user:password@localhost:5432/lenr_db
