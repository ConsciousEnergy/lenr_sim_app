# Uvicorn watch ignore file
# Prevents file watcher from scanning these directories/files

# Virtual environments
venv/
env/
.venv/
.env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Data files
data/
*.db
*.sqlite
*.sqlite3

# Test coverage
htmlcov/
.coverage
.pytest_cache/
.tox/

# Documentation
docs/_build/
docs/.build/

# Distribution
dist/
build/
*.egg-info/
*.egg

# Node modules (if any)
node_modules/

# Large files
*.csv
*.json
*.pkl
*.h5
*.hdf5
*.npy
*.npz

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
temp/
tmp/
