# LENR Simulation App - Backend environment template
# Copy to .env and fill in values. All vars use LENR_ prefix when set in environment.

# Environment: development | test | production
LENR_ENVIRONMENT=development
LENR_DEBUG=false

# Database (PostgreSQL; omit or use SQLite for local dev)
LENR_DB_HOST=localhost
LENR_DB_PORT=5432
LENR_DB_USER=lenr_user
LENR_DB_PASSWORD=changeme
LENR_DB_NAME=lenr_sim

# Or set a full URL instead of DB_* (overrides DB_* if set)
# LENR_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Security (required in production)
LENR_SECRET_KEY=generate-a-secure-random-key
LENR_JWT_SECRET_KEY=generate-a-secure-jwt-key

# CORS (comma-separated origins)
LENR_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LENR_LOG_LEVEL=INFO
LENR_LOG_TO_FILE=true
LENR_LOG_FILE_DIR=logs

# Optional: rate limiting, secure headers (defaults are sensible)
# LENR_ENABLE_RATE_LIMITING=true
# LENR_RATE_LIMIT_PER_MINUTE=60
# LENR_ENABLE_SECURE_HEADERS=true
