{
  "schema": "lenr-app-dataset-v1",
  "id": "screening_priors.v1",
  "disclaimer": "Cited U_e ranges used as UQ priors, not single deterministic constants.",
  "adiabatic_limit_eV": 25.0,
  "materials": [
    {
      "material": "palladium",
