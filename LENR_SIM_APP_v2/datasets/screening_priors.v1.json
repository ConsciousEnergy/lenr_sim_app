    },
    {
      "material": "lithium",
      "minimum_eV": 100.0,
      "typical_eV": 300.0,
      "maximum_eV": 600.0,
      "citations": ["huke2008"],
      "note": "Li-H / Rydberg-matter regime; estimate."
    }
  ]
