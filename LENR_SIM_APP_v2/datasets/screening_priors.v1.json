    {
      "material": "nickel",
      "minimum_eV": 200.0,
      "typical_eV": 500.0,
      "maximum_eV": 800.0,
      "citations": ["huke2008", "screeningreview2024"],
      "note": "H-H in Ni; estimate anchored to metal-host screening trend."
    },
    {
      "material": "titanium",
      "minimum_eV": 35.0,
      "typical_eV": 350.0,
      "maximum_eV": 600.0,
      "citations": ["raiola2002", "huke2008"],
