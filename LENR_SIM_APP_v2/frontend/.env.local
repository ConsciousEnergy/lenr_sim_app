# LENR Simulation App Frontend Environment Variables
# Copy this file to .env.local to configure your environment
# Create React App requires REACT_APP_ prefix for custom environment variables

# API Configuration
REACT_APP_API_URL=http://localhost:8010
REACT_APP_API_BASE_URL=http://localhost:8010

# Development Settings (optional)
REACT_APP_DEBUG_LEVEL=3
REACT_APP_USE_MOCK_DATA=false
REACT_APP_MOCK_DELAY=500

# Note: NODE_ENV is automatically set by Create React App:
# - 'development' when running npm start
# - 'test' when running npm test
# - 'production' when running npm run build
