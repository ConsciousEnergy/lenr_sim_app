{
  "name": "lenr-sim-app",
  "version": "0.1.0",
  "description": "LENR Simulation Platform - A comprehensive tool for simulating and analyzing Low Energy Nuclear Reactions",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConsciousEnergy/lenr_sim_app.git"
  },
  "homepage": "https://www.conscious.energy",
  "author": "Conscious Energy <info@conscious.energy>",
  "keywords": [
    "LENR",
    "nuclear-reactions",
    "simulation",
    "physics",
    "quantum-mechanics",
    "fusion",
    "clean-energy"
  ],
  "scripts": {
    "install:all": "cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
