{
  "extends": [
    "react-app"
  ],
  "rules": {
    // Warn instead of error for unused variables
    "no-unused-vars": ["warn", {
      "varsIgnorePattern": "^_",
      "argsIgnorePattern": "^_"
    }],
    "@typescript-eslint/no-unused-vars": ["warn", {
      "varsIgnorePattern": "^_",
      "argsIgnorePattern": "^_"
    }],
    
    // Disable exhaustive-deps for complex hooks
    "react-hooks/exhaustive-deps": "warn",
    
    // Allow anonymous default exports for utils
    "import/no-anonymous-default-export": ["warn", {
      "allowObject": true,
      "allowArray": true,
      "allowArrowFunction": false,
      "allowAnonymousClass": false,
      "allowAnonymousFunction": false,
      "allowLiteral": false
    }],
    
    // Warn for ref issues instead of error
    "react-hooks/rules-of-hooks": "error",
    
    // Turn off mixed operators warning
    "no-mixed-operators": "off"
  },
  "overrides": [
    {
      "files": ["*.test.js", "*.test.jsx", "*.test.ts", "*.test.tsx"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": ["src/utils/**/*.js", "src/services/**/*.js"],
      "rules": {
        "import/no-anonymous-default-export": "off"
      }
    }
  ]
}
