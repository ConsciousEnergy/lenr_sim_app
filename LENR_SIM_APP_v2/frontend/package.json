  "private": true,
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConsciousEnergy/lenr_sim_app.git"
  },
  "homepage": "https://www.conscious.energy",
  "author": "Conscious Energy <info@conscious.energy>",
  "description": "LENR Simulation Platform - Frontend Application",
  "proxy": "http://localhost:8010",
  "dependencies": {
    "@ant-design/icons": "^5.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@react-three/drei": "^9.88.2",
    "@react-three/fiber": "^8.15.0",
    "@tanstack/react-query": "^5.72.2",
    "@testing-library/user-event": "^13.5.0",
    "antd": "^5.4.0",
    "axios": "^1.13.6",
    "d3": "^7.8.4",
    "dotenv": "^16.4.5",
    "notistack": "^3.0.1",
    "qs": "^6.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.10.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.2",
    "three": "^0.159.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/d3": "^7.4.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.23",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@types/three": "^0.159.0",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.4.14",
    "cssnano": "^6.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3"
  },
  "overrides": {
    "@tootallnate/once": "2.0.0",
    "nth-check": "^2.1.1",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8",
    "postcss": "^8.4.31"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:analyze": "react-scripts build --stats && webpack-bundle-analyzer build/bundle-stats.json",
    "test": "react-scripts test --transformIgnorePatterns \"node_modules/(?!@three|three)/\"",
    "test:coverage": "react-scripts test --coverage --transformIgnorePatterns \"node_modules/(?!@three|three)/\"",
    "eject": "react-scripts eject",
    "tasks:list": "node scripts/dev.js list",
    "tasks:next": "node scripts/dev.js next",
    "tasks:parse": "node scripts/dev.js parse-prd --input=../PRD.txt",
    "tasks:generate": "node scripts/dev.js generate",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/src/tests/__mocks__/styleMock.js",
      "\\.(jpg|jpeg|png|gif|webp|svg)$": "<rootDir>/src/tests/__mocks__/fileMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!@three|three)/"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/tests/**",
      "!src/**/*.d.ts",
      "!src/index.{js,jsx,ts,tsx}",
      "!src/setupTests.{js,jsx,ts,tsx}"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
