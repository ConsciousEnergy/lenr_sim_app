  },
  "homepage": "https://www.conscious.energy",
  "author": "Conscious Energy <info@conscious.energy>",
  "description": "LENR Simulation Platform - Frontend Application",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "d3": "^7.8.4",
    "dotenv": "^18.0.5",
    "notistack": "^3.0.1",
    "posthog-js": "^1.435.6",
    "qs": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.2",
    "three": "^0.186.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/d3": "^7.4.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.23",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.6.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "nth-check": "^2.1.1",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8",
    "postcss": "^8.5.23",
    "js-yaml": "^4.3.2",
    "svgo": "^3.3.5",
    "qs": "^6.16.0",
    "colord": "^2.9.4",
    "esbuild": "^0.25.0",
    "brace-expansion": "^1.1.18",
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.7",
    "browserslist": "^4.28.7",
    "dompurify": "^3.4.16",
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "jest --config jest.config.js --watchAll=false",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "tasks:list": "node scripts/dev.js list",
    "tasks:next": "node scripts/dev.js next",
    "tasks:parse": "node scripts/dev.js parse-prd --input=../PRD.txt",
    "tasks:generate": "node scripts/dev.js generate",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:live": "playwright test tests/e2e/live-smoke.spec.js --project=chromium"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/src/tests/__mocks__/styleMock.js",
      "\\.(jpg|jpeg|png|gif|webp|svg)$": "<rootDir>/src/tests/__mocks__/fileMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!@three|three)/"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/tests/**",
      "!src/**/*.d.ts",
      "!src/index.{js,jsx,ts,tsx}",
      "!src/setupTests.{js,jsx,ts,tsx}"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
