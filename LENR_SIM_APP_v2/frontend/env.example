# LENR Simulation App - Frontend environment template
# Copy to .env.local and adjust values as needed. Real .env* files are
# gitignored; only *.example templates are tracked.
#
# In development the app talks to the backend through the Vite dev-server
# proxy (see vite.config.js: /api and /ws -> http://127.0.0.1:8010), so the
# API URL below only matters for the proxy target and for production builds.

# Backend API URL (no trailing slash)
# Production: https://api.conscious.energy
REACT_APP_API_URL=http://localhost:8010
VITE_API_URL=http://localhost:8010

# Optional development settings (defaults shown)
# REACT_APP_DEBUG_LEVEL=3
# REACT_APP_USE_MOCK_DATA=false
# REACT_APP_MOCK_DELAY=500
# Bypass the dev proxy and call REACT_APP_API_URL directly
# REACT_APP_FORCE_DIRECT_API=false

# Disable source maps in production builds
GENERATE_SOURCEMAP=false
