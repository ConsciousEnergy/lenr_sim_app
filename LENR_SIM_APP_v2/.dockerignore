# Version control
.git/
.gitignore

# IDE
.cursor/
.vscode/
.idea/

# Dependencies (rebuilt in image)
node_modules/
__pycache__/
*.pyc
*.pyo

# Environment files
.env
.env.*
!.env.example

# Test and development
tests/
app/tests/
*.test.*
htmlcov/
.coverage
.pytest_cache/

# Data and logs
*.db
*.sqlite*
logs/
data/

# Documentation
docs/
*.md
!README.md

# Frontend sources are required when building Dockerfile.frontend from this
# context; Dockerfile.backend does not COPY them. Keep node_modules/ ignored
# above so the frontend image still runs npm ci inside the builder stage.

