# Production environment for the Hostinger VPS same-origin stack.
# Copy to /opt/lenr-sim/.env (mode 0600) and fill every CHANGE_ME value.
# docker compose loads this file; never commit a filled copy.

# --- images / site ---
IMAGE_TAG=0.3.6-beta
SITE_ADDRESS=beta.conscious.energy
LENR_WORKERS=1

# --- app ---
LENR_ENVIRONMENT=production
LENR_SECRET_KEY=CHANGE_ME
LENR_JWT_SECRET_KEY=CHANGE_ME
LENR_ANALYTICS_WRITE_TOKEN=CHANGE_ME
LENR_CORS_ORIGINS=["https://beta.conscious.energy"]
LENR_AUTO_PERSIST=0
LENR_LOG_LEVEL=info
LENR_LOG_TO_FILE=true
LENR_LOG_JSON_FORMAT=true
LENR_ENABLE_RATE_LIMITING=true
LENR_HTTPS_REDIRECT=false
LENR_MAX_CONCURRENT_HEAVY_SIMS=2
LENR_HEAVY_SLOT_WAIT_SECONDS=10

# --- postgres (container + app; keep these four in lockstep) ---
LENR_DB_HOST=postgres
LENR_DB_PORT=5432
LENR_DB_USER=lenr_app
LENR_DB_PASSWORD=CHANGE_ME
LENR_DB_NAME=lenr_sim

# --- GHCR (optional; leave empty to build locally) ---
GHCR_USER=
GHCR_TOKEN=
