# Production environment for the Hostinger VPS same-origin (Compose) stack.
# Copy to /opt/lenr-sim/.env (mode 0600) and fill every CHANGE_ME value.
# docker compose loads this file; never commit a filled copy.
# Live public Swarm uses Traefik separately; keep this example for Compose rollback/lab.

# --- images / site ---
# Keep IMAGE_TAG equal to tip APP_VERSION (backend/app/core/config.py).
# CI deploy forces this from APP_VERSION (UPDATE_ENV_IMAGE_TAG=1).
IMAGE_TAG=0.3.9-beta
# Site hostnames are configured in infrastructure/vps/Caddyfile (literal
# comma-separated site line). Do not set SITE_ADDRESS here — Caddy cannot
# split multi-host values from env and will crash-loop.
# Live same-origin share: https://lenr-sim-beta.conscious.energy
# PostHog product key is NOT a runtime VPS .env var — Vite bakes it into the
# SPA at image build. Path B / GHCR: set repository Actions secret
# VITE_POSTHOG_KEY (optional VITE_POSTHOG_HOST). Leave secret unset → analytics
# no-op. For local / Compose fallback builds (e.g. after a failed GHCR pull),
# export VITE_POSTHOG_KEY (and optional VITE_POSTHOG_HOST) in the *host*
# environment so docker-compose.prod.yml can pass them as build-args — do not
# put a phc_ value in this file. autocapture stays false in code (privacy).
LENR_WORKERS=1

# --- app ---
LENR_ENVIRONMENT=production
LENR_SECRET_KEY=CHANGE_ME
LENR_JWT_SECRET_KEY=CHANGE_ME
LENR_ANALYTICS_WRITE_TOKEN=CHANGE_ME
LENR_CORS_ORIGINS=["https://lenr-sim-beta.conscious.energy","https://app.conscious.energy","https://lenr-simp-app.conscious.energy","https://srv1280333.hstgr.cloud"]
LENR_AUTO_PERSIST=0
LENR_LOG_LEVEL=info
LENR_LOG_TO_FILE=true
LENR_LOG_JSON_FORMAT=true
LENR_ENABLE_RATE_LIMITING=true
LENR_HTTPS_REDIRECT=false
LENR_MAX_CONCURRENT_HEAVY_SIMS=2
LENR_HEAVY_SLOT_WAIT_SECONDS=10

# --- postgres (container + app; keep these four in lockstep) ---
LENR_DB_HOST=postgres
LENR_DB_PORT=5432
LENR_DB_USER=lenr_app
LENR_DB_PASSWORD=CHANGE_ME
LENR_DB_NAME=lenr_sim

# --- GHCR (optional; leave empty to build locally) ---
GHCR_USER=
GHCR_TOKEN=
