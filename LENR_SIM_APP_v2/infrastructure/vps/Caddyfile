# Same-origin public beta.
#
# Hostnames must be written literally here (comma-separated). Caddy's
# {$ENV:default} substitution treats a multi-host env value as ONE address
# token, so commas inside SITE_ADDRESS break startup with:
#   Site addresses cannot contain a comma
#
# Only list names whose A/AAAA (or CNAME-to-this-VPS) records point here.
# A CNAME to conscious.energy is WordPress.com's own site mapping: HTTP-01
# then returns `got "WP.com"` and Let's Encrypt will not issue.
#
# Intended public name: lenr-simp-app.conscious.energy
# Add it to the site line below only after it resolves to 185.211.4.66
# (A record, or CNAME to srv1280333.hstgr.cloud — not to conscious.energy).

(app_proxy) {
	encode zstd gzip
	# LP-M1: reject oversized bodies with 413 before upstream (Compose share path).
	# Keep in sync with FastAPI REQUEST_MAX_BODY_SIZE (10 MiB) and Traefik
	# backend-bodylimit maxRequestBodyBytes=10485760 on Swarm.
	request_body {
		max_size 10MB
	}

	# LP-L2: quiet scanner noise before SPA reverse_proxy fallback.
	@scanner_noise path /.env /.git /.git/*
	handle @scanner_noise {
		respond 404
	}

	# FastAPI, including WebSocket upgrades under /api/ws, /api/visualization/ws,
	# and /api/unified/bubble-lattice/stream. Caddy strips client X-Forwarded-For.
	handle /api* {
		reverse_proxy backend:8000
	}

	# Prometheus /metrics is hidden in production FastAPI; do not SPA-fallback it.
	handle /metrics {
		respond 404
	}

	handle {
		reverse_proxy frontend:80
	}
}

lenr-sim-beta.conscious.energy, srv1280333.hstgr.cloud {
	import app_proxy
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Strip XFO so CSP frame-ancestors can allow WordPress embeds (SEC-01).
		# Compose rollback path only — Swarm Traefik uses spa-security-headers.
		-X-Frame-Options
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
