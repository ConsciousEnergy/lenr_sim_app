# Multi-stage build for LENR Sim App frontend
# Produces optimized static build artifact

# Stage 1: Build
FROM node:26-alpine AS builder

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --production=false

COPY frontend/ .

ARG REACT_APP_API_URL=https://api.conscious.energy
ARG VITE_API_URL=https://api.conscious.energy
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS production

# Vite emits to dist/ (CRA used build/); keep nginx root in sync with vite.config.js
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA fallback
RUN echo 'server { listen 80; root /usr/share/nginx/html; index index.html; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; location / { try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
