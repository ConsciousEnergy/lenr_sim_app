# Multi-stage build for LENR Sim App frontend
# Produces optimized static build artifact

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --production=false

COPY frontend/ .

# same-origin: the SPA and /api share one TLS host (Caddy on the VPS).
# Split-host builds override this with VITE_API_URL=https://api.<domain>.
ARG REACT_APP_API_URL=same-origin
ARG VITE_API_URL=same-origin
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV VITE_API_URL=${VITE_API_URL}

# Product analytics (PostHog): Vite bakes these at build time. Leave empty for
# forks/PRs/local builds without a key — init is a no-op when unset.
# Never commit a phc_ value; pass via CI secret → build-arg only.
# autocapture stays false in frontend/src/analytics/posthog.js (privacy).
ARG VITE_POSTHOG_KEY=
ARG REACT_APP_POSTHOG_KEY=
ARG VITE_POSTHOG_HOST=
ARG REACT_APP_POSTHOG_HOST=
ENV VITE_POSTHOG_KEY=${VITE_POSTHOG_KEY}
ENV REACT_APP_POSTHOG_KEY=${REACT_APP_POSTHOG_KEY}
ENV VITE_POSTHOG_HOST=${VITE_POSTHOG_HOST}
ENV REACT_APP_POSTHOG_HOST=${REACT_APP_POSTHOG_HOST}

RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS production

# Vite emits to dist/ (CRA used build/); keep nginx root in sync with vite.config.js
COPY --from=builder /app/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
