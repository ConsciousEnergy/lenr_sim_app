# LENR Simulation App - FastAPI Backend Dockerfile
# Multi-stage build for optimized production image

# ==============================================================================
# Stage 1: Build dependencies
# ==============================================================================
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ==============================================================================
# Stage 2: Production image
# ==============================================================================
FROM python:3.12-slim AS production

ARG BUILD_VERSION=0.3.7-beta

# Labels
LABEL org.opencontainers.image.title="LENR Simulation App Backend"
LABEL org.opencontainers.image.description="FastAPI backend for LENR Simulation Platform"
LABEL org.opencontainers.image.version="${BUILD_VERSION}"
LABEL org.opencontainers.image.vendor="Conscious Energies"
LABEL org.opencontainers.image.url="https://conscious.energy"
LABEL org.opencontainers.image.source="https://github.com/ConsciousEnergy/lenr_sim_app"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=appuser:appgroup backend/app ./app
COPY --chown=appuser:appgroup backend/alembic ./alembic
COPY --chown=appuser:appgroup backend/alembic.ini ./
# Hydrate CLI (`seed_database --hydrate-demo`) needs literature + reviewer packs.
COPY --chown=appuser:appgroup datasets ./datasets

# Copy entrypoint script (reads Docker secrets into env vars). The explicit
# chmod keeps startup working even if the source file loses its +x bit on a
# checkout that does not preserve POSIX modes (e.g. Windows clones).
COPY --chown=appuser:appgroup infrastructure/docker/entrypoint.sh /entrypoint.sh
RUN chmod 0555 /entrypoint.sh

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/static /app/static/cluster_fields && \
    chown -R appuser:appgroup /app

# Environment variables. LENR_WORKERS defaults to 1: rate-limit, WebSocket and
# shared-simulation state is per-process (see app/core/compute_guard.py), so
# extra workers would fragment it. Raise only with a shared store in place.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8000 \
    LENR_WORKERS=1

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Entrypoint reads Docker secrets into environment variables
ENTRYPOINT ["/entrypoint.sh"]

# Run with uvicorn behind a reverse proxy (Caddy/Traefik terminate TLS and set
# X-Forwarded-*; the proxy strips client-supplied forwarding headers).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${LENR_WORKERS:-1} --proxy-headers --forwarded-allow-ips='*'"]
