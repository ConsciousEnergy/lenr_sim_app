# Traefik Dynamic Configuration
# LENR Simulation App

http:
  middlewares:
    # API / non-embeddable routes — deny framing.
    security-headers:
      headers:
        frameDeny: true
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow"

    # SPA only — allow WordPress apex/www to iframe the beta UI.
    # Explicitly disable frameDeny: live probes showed X-Frame-Options: DENY
    # fighting CSP frame-ancestors (SEC-01). Do NOT set customFrameOptionsValue.
    # CSP frame-ancestors is the allowlist (also set by nginx.frontend.conf).
    spa-security-headers:
      headers:
        frameDeny: false
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        referrerPolicy: "strict-origin-when-cross-origin"
        # DAS-M1: drop bare wss: and img-src https:; allow explicit api wss only.
        contentSecurityPolicy: "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://conscious.energy https://www.conscious.energy; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.conscious.energy wss://api.conscious.energy https://us.i.posthog.com https://lenr-sim-beta.conscious.energy https://app.conscious.energy; worker-src 'self' blob:; form-action 'self'"
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow"
          # Ops canary after Swarm apply: SPA must NOT emit X-Frame-Options.
          X-Frame-Policy: "csp-frame-ancestors"

    # LP-H2: edge rate limits live HERE (file provider) so a Traefik dynamic
    # reload fences compute/write paths without depending on Swarm service
    # label-adds surviving image-only updates. Swarm labels only attach the
    # general API router to `@file` middlewares; heavy/write routers are below.
    # depth=1 = rightmost XFF hop (TCP peer Traefik appended). Budgets match
    # FastAPI RATE_LIMIT / HEAVY / WRITE per-minute settings.
    backend-ratelimit:
      rateLimit:
        average: 60
        burst: 30
        period: 1m
        sourceCriterion:
          ipStrategy:
            depth: 1

    backend-ratelimit-heavy:
      rateLimit:
        average: 10
        burst: 5
        period: 1m
        sourceCriterion:
          ipStrategy:
            depth: 1

    backend-ratelimit-write:
      rateLimit:
        average: 3
        burst: 3
        period: 1m
        sourceCriterion:
          ipStrategy:
            depth: 1

    # LP-M1: 413 oversized bodies before FastAPI (matches REQUEST_MAX_BODY_SIZE /
    # Caddy request_body 10MB). Wired on backend routers in docker-stack.yml.j2.
    backend-bodylimit:
      buffering:
        maxRequestBodyBytes: 10485760
        memRequestBodyBytes: 1048576

    # CORS configuration
    cors:
      headers:
        accessControlAllowMethods:
          - GET
          - POST
          - PUT
          - DELETE
          - OPTIONS
        accessControlAllowHeaders:
          - Content-Type
          - Authorization
          - X-Requested-With
        accessControlAllowOriginList:
          - "https://{{ app_domain }}"
          - "https://www.{{ app_domain }}"
          - "https://{{ api_subdomain }}.{{ app_domain }}"
{% for _h in (traefik_spa_hosts | default([])) %}
          - "https://{{ _h }}"
{% endfor %}
{% for _o in (cors_extra_origins | default([])) %}
          - "{{ _o }}"
{% endfor %}
        accessControlMaxAge: 3600
        addVaryHeader: true
        
    # Compress responses
    compress:
      compress: {}
      
    # Strip API prefix if needed
    strip-api-prefix:
      stripPrefix:
        prefixes:
          - "/api"

{% set _api_host = api_subdomain ~ '.' ~ app_domain %}
{% set _heavy_rule = "(PathPrefix(`/api/physics/`) || PathPrefix(`/api/multi-physics/`) || PathPrefix(`/api/unified/`) || PathPrefix(`/api/analytics/`))" %}
{% set _write_rule = "(PathPrefix(`/api/simulations/save`) || PathPrefix(`/api/simulations/share`))" %}
{# Traefik v3 Method() accepts exactly one arg; OR the verbs (live v3.6.1). #}
{% set _mutate_rule = "(Method(`POST`) || Method(`PUT`) || Method(`PATCH`) || Method(`DELETE`))" %}
{% set _raw_extra = traefik_extra_api_hosts | default([]) %}
{% if _raw_extra is string %}
{% set _extra_ns = namespace(hosts=([_raw_extra] if (_raw_extra | length > 0) else [])) %}
{% else %}
{% set _extra_ns = namespace(hosts=(_raw_extra | list)) %}
{% endif %}
{% if traefik_acme_bootstrap_host is defined and (traefik_acme_bootstrap_host | length > 0) %}
{% set _ = _extra_ns.hosts.append(traefik_acme_bootstrap_host) %}
{% endif %}
  # Path RL routers (priority > Swarm general backend / backend-extra=100).
  # Service `backend@swarm` is defined on the backend Swarm service labels.
  routers:
    backend-write:
      rule: "Host(`{{ _api_host }}`) && {{ _mutate_rule }} && {{ _write_rule }}"
      entryPoints:
        - websecure
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-write
      service: backend@swarm
      priority: 300
      tls:
        certResolver: letsencrypt
    backend-heavy:
      rule: "Host(`{{ _api_host }}`) && {{ _mutate_rule }} && {{ _heavy_rule }}"
      entryPoints:
        - websecure
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-heavy
      service: backend@swarm
      priority: 200
      tls:
        certResolver: letsencrypt
{% if not (traefik_force_https | default(true)) %}
    backend-write-http:
      rule: "Host(`{{ _api_host }}`) && {{ _mutate_rule }} && {{ _write_rule }}"
      entryPoints:
        - web
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-write
      service: backend@swarm
      priority: 300
    backend-heavy-http:
      rule: "Host(`{{ _api_host }}`) && {{ _mutate_rule }} && {{ _heavy_rule }}"
      entryPoints:
        - web
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-heavy
      service: backend@swarm
      priority: 200
{% endif %}
{% for _host in _extra_ns.hosts | unique %}
    backend-extra-{{ loop.index }}-write:
      rule: "Host(`{{ _host }}`) && {{ _mutate_rule }} && {{ _write_rule }}"
      entryPoints:
        - websecure
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-write
      service: backend@swarm
      priority: 300
      tls:
        certResolver: letsencrypt
    backend-extra-{{ loop.index }}-heavy:
      rule: "Host(`{{ _host }}`) && {{ _mutate_rule }} && {{ _heavy_rule }}"
      entryPoints:
        - websecure
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-heavy
      service: backend@swarm
      priority: 200
      tls:
        certResolver: letsencrypt
{% if not (traefik_force_https | default(true)) %}
    backend-extra-{{ loop.index }}-write-http:
      rule: "Host(`{{ _host }}`) && {{ _mutate_rule }} && {{ _write_rule }}"
      entryPoints:
        - web
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-write
      service: backend@swarm
      priority: 300
    backend-extra-{{ loop.index }}-heavy-http:
      rule: "Host(`{{ _host }}`) && {{ _mutate_rule }} && {{ _heavy_rule }}"
      entryPoints:
        - web
      middlewares:
        - security-headers
        - backend-bodylimit
        - backend-ratelimit-heavy
      service: backend@swarm
      priority: 200
{% endif %}
{% endfor %}

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
