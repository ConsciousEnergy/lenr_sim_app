# Traefik Dynamic Configuration
# LENR Simulation App

http:
  middlewares:
    # API / non-embeddable routes — deny framing.
    security-headers:
      headers:
        frameDeny: true
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow"

    # SPA only — allow WordPress apex/www to iframe the beta UI.
    # Do not set frameDeny / X-Frame-Options; CSP frame-ancestors is the allowlist
    # (also set by nginx.frontend.conf). Keep HSTS/nosniff/XSS filter.
    spa-security-headers:
      headers:
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        referrerPolicy: "strict-origin-when-cross-origin"
        contentSecurityPolicy: "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://conscious.energy https://www.conscious.energy; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.conscious.energy https://us.i.posthog.com wss: https://lenr-sim-beta.conscious.energy https://app.conscious.energy; worker-src 'self' blob:; form-action 'self'"
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow"
          
    # Rate limiting for API
    api-ratelimit:
      rateLimit:
        average: 100
        burst: 50
        period: 1m
        
    # CORS configuration
    cors:
      headers:
        accessControlAllowMethods:
          - GET
          - POST
          - PUT
          - DELETE
          - OPTIONS
        accessControlAllowHeaders:
          - Content-Type
          - Authorization
          - X-Requested-With
        accessControlAllowOriginList:
          - "https://{{ app_domain }}"
          - "https://www.{{ app_domain }}"
          - "https://{{ api_subdomain }}.{{ app_domain }}"
{% for _h in (traefik_spa_hosts | default([])) %}
          - "https://{{ _h }}"
{% endfor %}
{% for _o in (cors_extra_origins | default([])) %}
          - "{{ _o }}"
{% endfor %}
        accessControlMaxAge: 3600
        addVaryHeader: true
        
    # Compress responses
    compress:
      compress: {}
      
    # Strip API prefix if needed
    strip-api-prefix:
      stripPrefix:
        prefixes:
          - "/api"

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
