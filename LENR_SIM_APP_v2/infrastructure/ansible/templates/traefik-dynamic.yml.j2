# Traefik Dynamic Configuration
# LENR Simulation App

http:
  middlewares:
    # API / non-embeddable routes — deny framing.
    security-headers:
      headers:
        frameDeny: true
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow"

    # SPA only — allow WordPress apex/www to iframe the beta UI.
    # Explicitly disable frameDeny: live probes showed X-Frame-Options: DENY
    # fighting CSP frame-ancestors (SEC-01). Do NOT set customFrameOptionsValue.
    # CSP frame-ancestors is the allowlist (also set by nginx.frontend.conf).
    spa-security-headers:
      headers:
        frameDeny: false
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        referrerPolicy: "strict-origin-when-cross-origin"
        # DAS-M1: drop bare wss: and img-src https:; allow explicit api wss only.
        contentSecurityPolicy: "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://conscious.energy https://www.conscious.energy; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.conscious.energy wss://api.conscious.energy https://us.i.posthog.com https://lenr-sim-beta.conscious.energy https://app.conscious.energy; worker-src 'self' blob:; form-action 'self'"
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow"
          # Ops canary after Swarm apply: SPA must NOT emit X-Frame-Options.
          X-Frame-Policy: "csp-frame-ancestors"

    # NOTE: API rate limiting lives on Swarm service labels as
    # `backend-ratelimit` / `backend-ratelimit-heavy` / `backend-ratelimit-write`
    # (docker-stack.yml.j2) with sourceCriterion.ipStrategy.depth=1. Path routers
    # apply heavy/write budgets on mutate methods. A prior unused `api-ratelimit`
    # file middleware was removed to avoid drift.

    # LP-M1: 413 oversized bodies before FastAPI (matches REQUEST_MAX_BODY_SIZE /
    # Caddy request_body 10MB). Wired on backend routers in docker-stack.yml.j2.
    backend-bodylimit:
      buffering:
        maxRequestBodyBytes: 10485760
        memRequestBodyBytes: 1048576

    # CORS configuration
    cors:
      headers:
        accessControlAllowMethods:
          - GET
          - POST
          - PUT
          - DELETE
          - OPTIONS
        accessControlAllowHeaders:
          - Content-Type
          - Authorization
          - X-Requested-With
        accessControlAllowOriginList:
          - "https://{{ app_domain }}"
          - "https://www.{{ app_domain }}"
          - "https://{{ api_subdomain }}.{{ app_domain }}"
{% for _h in (traefik_spa_hosts | default([])) %}
          - "https://{{ _h }}"
{% endfor %}
{% for _o in (cors_extra_origins | default([])) %}
          - "{{ _o }}"
{% endfor %}
        accessControlMaxAge: 3600
        addVaryHeader: true
        
    # Compress responses
    compress:
      compress: {}
      
    # Strip API prefix if needed
    strip-api-prefix:
      stripPrefix:
        prefixes:
          - "/api"

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
