# Traefik Static Configuration
# LENR Simulation App

api:
  # Keep in lockstep with group_vars traefik_dashboard_enabled (CLI flag is source of truth).
  dashboard: {{ traefik_dashboard_enabled | default(false) | bool | lower }}
  insecure: false

log:
  level: INFO
  format: json

accessLog:
  format: json
  filters:
    statusCodes:
      - "400-599"

providers:
  # Traefik v3: use Swarm provider (docker.swarmMode was removed).
  swarm:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: lenr-sim-network
  file:
    directory: /etc/traefik/dynamic
    watch: true

entryPoints:
  web:
    address: ":80"
{% if traefik_force_https | default(true) %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
{% endif %}
          
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt

  # Overlay-only Prometheus scrape (do not publish 8082 on the host firewall).
  metrics:
    address: ":8082"

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addServicesLabels: true
    addRoutersLabels: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik_acme_email }}"
      storage: /certs/acme.json
{% if traefik_acme_staging | default(false) %}
      # Let's Encrypt staging CA — use until public DNS for api-staging is correct.
      caServer: https://acme-staging-v02.api.letsencrypt.org/directory
{% endif %}
      httpChallenge:
        entryPoint: web

# NOTE: Do not put top-level `http:` (middlewares/routers/services) here.
# Traefik v3 static config rejects `http` (`field not found, node: http`).
# Security headers, CORS, rate limits live in traefik-dynamic.yml.j2
# (providers.file.directory = /etc/traefik/dynamic).
