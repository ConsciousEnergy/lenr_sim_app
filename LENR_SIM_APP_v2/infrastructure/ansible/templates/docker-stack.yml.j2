# LENR Simulation App - Docker Stack Definition
# Deploys: Traefik (reverse proxy), FastAPI (backend), PostgreSQL (database)

version: "3.9"

services:
  # ============================================================================
  # Traefik - Reverse Proxy & SSL
  # ============================================================================
  traefik:
    # v3.6.1+ negotiates Docker API (required for Engine 29; v3.0 hardcodes 1.24).
    image: traefik:{{ traefik_version | default('v3.6.1') }}
    command:
      - "--configFile=/etc/traefik/traefik.yml"
      # Traefik v3: Swarm is a separate provider (swarmMode removed from docker).
      - "--providers.swarm=true"
      - "--providers.swarm.endpoint=unix:///var/run/docker.sock"
      - "--providers.swarm.exposedbydefault=false"
      - "--providers.swarm.network=lenr-sim-network"
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.metrics.address=:8082"
      - "--metrics.prometheus=true"
      - "--metrics.prometheus.entrypoint=metrics"
{% if traefik_force_https | default(true) %}
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
      - "--entrypoints.web.http.redirections.entryPoint.permanent=true"
{% endif %}
      - "--certificatesresolvers.letsencrypt.acme.email={{ traefik_acme_email | quote }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/certs/acme.json"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
{% if traefik_acme_staging | default(false) %}
      - "--certificatesresolvers.letsencrypt.acme.caserver=https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
      # Dashboard is off by default. Do not publish traefik.{{ app_domain }}
      # with placeholder basic-auth. Operators who need it must set
      # traefik_dashboard_enabled and a real traefik_dashboard_basic_auth.
      - "--api.dashboard={{ 'true' if (traefik_dashboard_enabled | default(false)) else 'false' }}"
      - "--log.level=INFO"
      - "--accesslog=true"
    ports:
      - target: 80
        published: 80
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: tcp
        mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/lenr-sim/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - /opt/lenr-sim/traefik/dynamic:/etc/traefik/dynamic:ro
      - /opt/lenr-sim/traefik/certs:/certs
    networks:
      - lenr-sim-network
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      labels:
        # Keep Traefik itself off the Swarm provider unless dashboard is enabled
        # (avoids "port is missing" when only ACME labels are present).
        - "traefik.enable={{ 'true' if (traefik_dashboard_enabled | default(false)) else 'false' }}"
        # ACME challenge router (exclude from HTTPS redirect)
        - "traefik.http.routers.acme.rule=PathPrefix(`/.well-known/acme-challenge/`)"
        - "traefik.http.routers.acme.entrypoints=web"
        - "traefik.http.routers.acme.priority=1000"
{% if (traefik_dashboard_enabled | default(false)) and traefik_dashboard_basic_auth is defined and ('xxxxx' not in traefik_dashboard_basic_auth) %}
        - "traefik.http.routers.dashboard.rule=Host(`traefik.{{ app_domain }}`)"
        - "traefik.http.routers.dashboard.service=api@internal"
        - "traefik.http.routers.dashboard.entrypoints=websecure"
        - "traefik.http.routers.dashboard.tls.certresolver=letsencrypt"
        - "traefik.http.routers.dashboard.middlewares=dashboard-auth"
        - "traefik.http.middlewares.dashboard-auth.basicauth.users={{ traefik_dashboard_basic_auth }}"
        - "traefik.http.services.dashboard.loadbalancer.server.port=8080"
{% endif %}

  # ============================================================================
  # FastAPI Backend
  # ============================================================================
  backend:
    image: ghcr.io/{{ github_owner | default('consciousenergy') | lower }}/lenr-sim-backend:{{ backend_image_tag | default(app_version) | default('0.3.9-beta') }}
    environment:
      # LENR_*-prefixed vars feed Pydantic Settings (env_prefix="LENR_").
      # Use lenr_environment — Ansible's built-in `environment` is a reserved mapping.
      - LENR_ENVIRONMENT={{ lenr_environment | default('production') }}
      - LENR_DB_HOST=postgres
      - LENR_DB_PORT=5432
      - LENR_DB_USER={{ postgres_user | default('lenr_app') }}
      - LENR_DB_NAME={{ postgres_db | default('lenr_sim') }}
      - LENR_LOG_LEVEL={{ fastapi_log_level | default('info') }}
      - LENR_LOG_TO_FILE={{ 'true' if (lenr_log_to_file | default(true)) else 'false' }}
      - LENR_LOG_JSON_FORMAT=true
      - >-
        LENR_CORS_ORIGINS=["https://{{ app_domain }}","https://www.{{ app_domain }}","https://{{ api_subdomain }}.{{ app_domain }}"{% for _h in (traefik_spa_hosts | default([])) %},"https://{{ _h }}"{% endfor %}]
      - LENR_ENABLE_RATE_LIMITING=true
      - LENR_HTTPS_REDIRECT=false
      - LENR_AUTO_PERSIST=0
      # Unprefixed DB_* aliases for get_database_url() / os.getenv readers
      # (entrypoint also exports DB_PASSWORD from the Swarm secret).
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_USER={{ postgres_user | default('lenr_app') }}
      - DB_NAME={{ postgres_db | default('lenr_sim') }}
      - DB_PASSWORD_FILE=/run/secrets/postgres_password
    secrets:
      - source: postgres_password
        target: postgres_password
      - source: api_secret_key
        target: api_secret_key
    volumes:
      - /opt/lenr-sim/logs:/app/logs
      - /opt/lenr-sim/data:/app/data
    networks:
      - lenr-sim-network
    # Note: depends_on is ignored in Docker Swarm; backend should implement DB connection retry logic
    deploy:
      mode: replicated
      replicas: {{ fastapi_workers | default(2) }}
      # Production (require_app_label=true): pin to nodes labeled app=true
      # (share manager + KVM1 worker). Staging default leaves unconstrained so
      # single-node KVM1 works before labels are applied.
      # Use separate label keys (app / observability) — Swarm allows one value per key.
      placement:
        preferences:
          - spread: node.labels.app
{% if require_app_label | default(false) %}
        constraints:
          - node.labels.app == true
{% endif %}
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
        failure_action: rollback
        monitor: 30s
      rollback_config:
        parallelism: 1
        order: stop-first
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.25'
          memory: 512M
      labels:
        - "traefik.enable=true"
        # API Router (HTTPS). Staging may also expose HTTP until DNS/ACME is ready.
        - "traefik.http.routers.backend.rule=Host(`{{ api_subdomain }}.{{ app_domain }}`)"
        - "traefik.http.routers.backend.entrypoints=websecure"
        - "traefik.http.routers.backend.tls.certresolver=letsencrypt"
{% if not (traefik_force_https | default(true)) %}
        - "traefik.http.routers.backend-http.rule=Host(`{{ api_subdomain }}.{{ app_domain }}`)"
        - "traefik.http.routers.backend-http.entrypoints=web"
        - "traefik.http.routers.backend-http.middlewares=security-headers@file,backend-ratelimit"
        - "traefik.http.routers.backend-http.service=backend"
{% endif %}
{# Extra API Host() routers: sslip bootstrap and/or lenr-sim-beta during WP DNS lag.
   Separate routers so ACME can succeed on hosts that already resolve even when
   api.* still parks at WordPress. Guard strings so CLI -e '["host"]' is not
   character-iterated. #}
{% set _raw_extra = traefik_extra_api_hosts | default([]) %}
{% if _raw_extra is string %}
{% set _extra_ns = namespace(hosts=([_raw_extra] if (_raw_extra | length > 0) else [])) %}
{% else %}
{% set _extra_ns = namespace(hosts=(_raw_extra | list)) %}
{% endif %}
{% if traefik_acme_bootstrap_host is defined and (traefik_acme_bootstrap_host | length > 0) %}
{% set _ = _extra_ns.hosts.append(traefik_acme_bootstrap_host) %}
{% endif %}
{% for _host in _extra_ns.hosts | unique %}
        # PathPrefix so SPA can share the host (e.g. lenr-sim-beta) with the API.
        - "traefik.http.routers.backend-extra-{{ loop.index }}.rule=Host(`{{ _host }}`) && PathPrefix(`/api`)"
        - "traefik.http.routers.backend-extra-{{ loop.index }}.priority=100"
        - "traefik.http.routers.backend-extra-{{ loop.index }}.entrypoints=websecure"
        - "traefik.http.routers.backend-extra-{{ loop.index }}.tls.certresolver=letsencrypt"
        - "traefik.http.routers.backend-extra-{{ loop.index }}.middlewares=security-headers@file,backend-ratelimit"
        - "traefik.http.routers.backend-extra-{{ loop.index }}.service=backend"
        - "traefik.http.routers.backend-extra-{{ loop.index }}-http.rule=Host(`{{ _host }}`) && PathPrefix(`/api`)"
        - "traefik.http.routers.backend-extra-{{ loop.index }}-http.priority=100"
        - "traefik.http.routers.backend-extra-{{ loop.index }}-http.entrypoints=web"
        - "traefik.http.routers.backend-extra-{{ loop.index }}-http.middlewares=security-headers@file,backend-ratelimit"
        - "traefik.http.routers.backend-extra-{{ loop.index }}-http.service=backend"
{% endfor %}
        # security-headers is defined in traefik-dynamic.yml.j2 (file provider).
        - "traefik.http.routers.backend.middlewares=security-headers@file,backend-ratelimit"
        # Service
        - "traefik.http.services.backend.loadbalancer.server.port=8000"
        - "traefik.http.services.backend.loadbalancer.healthcheck.path=/api/health"
        - "traefik.http.services.backend.loadbalancer.healthcheck.interval=30s"
        # Rate Limiting
        - "traefik.http.middlewares.backend-ratelimit.ratelimit.average=100"
        - "traefik.http.middlewares.backend-ratelimit.ratelimit.burst=50"
        - "traefik.http.middlewares.backend-ratelimit.ratelimit.period=1m"

{% if swarm_frontend_enabled | default(false) %}
  # ============================================================================
  # Frontend SPA (nginx) — same-origin with /api on traefik_spa_hosts
  # ============================================================================
  frontend:
    image: ghcr.io/{{ github_owner | default('consciousenergy') | lower }}/lenr-sim-frontend:{{ frontend_image_tag | default(app_version) | default('0.3.9-beta') }}
    networks:
      - lenr-sim-network
    deploy:
      mode: replicated
      replicas: {{ frontend_replicas | default(2) }}
      placement:
        preferences:
          - spread: node.labels.app
{% if require_app_label | default(false) %}
        constraints:
          - node.labels.app == true
{% endif %}
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
        failure_action: rollback
        monitor: 30s
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: '0.50'
          memory: 256M
        reservations:
          cpus: '0.05'
          memory: 64M
      labels:
        - "traefik.enable=true"
{% set _raw_spa = traefik_spa_hosts | default([]) %}
{% if _raw_spa is string %}
{% set _spa_ns = namespace(hosts=([_raw_spa] if (_raw_spa | length > 0) else [])) %}
{% else %}
{% set _spa_ns = namespace(hosts=(_raw_spa | list)) %}
{% endif %}
{% for _host in _spa_ns.hosts | unique %}
        - "traefik.http.routers.frontend-{{ loop.index }}.rule=Host(`{{ _host }}`)"
        - "traefik.http.routers.frontend-{{ loop.index }}.priority=10"
        - "traefik.http.routers.frontend-{{ loop.index }}.entrypoints=websecure"
        - "traefik.http.routers.frontend-{{ loop.index }}.tls.certresolver=letsencrypt"
        - "traefik.http.routers.frontend-{{ loop.index }}.middlewares=security-headers@file"
        - "traefik.http.routers.frontend-{{ loop.index }}.service=frontend"
        - "traefik.http.routers.frontend-{{ loop.index }}-http.rule=Host(`{{ _host }}`)"
        - "traefik.http.routers.frontend-{{ loop.index }}-http.priority=10"
        - "traefik.http.routers.frontend-{{ loop.index }}-http.entrypoints=web"
        - "traefik.http.routers.frontend-{{ loop.index }}-http.middlewares=security-headers@file"
        - "traefik.http.routers.frontend-{{ loop.index }}-http.service=frontend"
{% endfor %}
        - "traefik.http.services.frontend.loadbalancer.server.port=80"
{% endif %}

  # ============================================================================
  # PostgreSQL Database
  # ============================================================================
  postgres:
    image: postgres:{{ postgres_version | default('16') }}-alpine
    environment:
      - POSTGRES_DB={{ postgres_db | default('lenr_sim') }}
      - POSTGRES_USER={{ postgres_user | default('lenr_app') }}
      - POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
    secrets:
      - postgres_password
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - lenr-sim-network
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
{% if postgres_volume_external | default(false) %}
          # Named volumes are node-local — pin to the share manager that holds
          # lenr-sim_postgres_data (label set in inventory.yml.example).
          - node.labels.postgres == true
{% endif %}
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.25'
          memory: 256M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user | default('lenr_app') }}"]
      interval: 10s
      timeout: 5s
      retries: 5

{% if observability_enabled | default(true) %}
  # ============================================================================
  # Prometheus (overlay scrape; not public)
  # ============================================================================
  prometheus:
    image: prom/prometheus:v2.54.1
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--web.enable-lifecycle"
    volumes:
      - /opt/lenr-sim/observability/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    networks:
      - lenr-sim-network
    deploy:
      mode: replicated
      replicas: 1
{% if require_observability_label | default(false) %}
      placement:
        constraints:
          - node.labels.observability == true
{% endif %}
      resources:
        limits:
          cpus: '0.50'
          memory: 512M
        reservations:
          cpus: '0.10'
          memory: 128M
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3

  # ============================================================================
  # Grafana (private / Traefik+auth; see OBSERVABILITY_GRAFANA.md)
  # ============================================================================
  grafana:
    image: grafana/grafana:11.2.0
    environment:
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user | default('admin') }}
      # File provider — never bake the password into the stack YAML.
      - GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s/
      - GF_ANALYTICS_REPORTING_ENABLED=false
      - GF_ANALYTICS_CHECK_FOR_UPDATES=false
      - GF_PATHS_PROVISIONING=/etc/grafana/provisioning
    secrets:
      - source: grafana_admin_password
        target: grafana_admin_password
        mode: 0400
    volumes:
      - grafana_data:/var/lib/grafana
      - /opt/lenr-sim/observability/grafana/provisioning:/etc/grafana/provisioning:ro
    networks:
      - lenr-sim-network
{% if (grafana_publish_host_port | default(0) | int) > 0 %}
    # Host-mode publish for SSH tunnel (ssh -L 3000:127.0.0.1:3000).
    # Keep UFW from allowing this port publicly — trust boundary is localhost/SSH.
    ports:
      - target: 3000
        published: {{ grafana_publish_host_port | int }}
        protocol: tcp
        mode: host
{% endif %}
    deploy:
      mode: replicated
      replicas: 1
{% if require_observability_label | default(false) %}
      placement:
        constraints:
          - node.labels.observability == true
{% endif %}
      resources:
        limits:
          cpus: '0.50'
          memory: 512M
        reservations:
          cpus: '0.10'
          memory: 128M
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      labels:
        - "traefik.enable={{ 'true' if (grafana_traefik_enabled | default(false)) else 'false' }}"
{% if grafana_traefik_enabled | default(false) %}
        - "traefik.http.routers.grafana.rule=Host(`{{ grafana_subdomain | default('grafana-staging') }}.{{ app_domain }}`)"
        - "traefik.http.routers.grafana.entrypoints=websecure"
        - "traefik.http.routers.grafana.tls.certresolver=letsencrypt"
        - "traefik.http.routers.grafana.middlewares=grafana-auth"
        - "traefik.http.middlewares.grafana-auth.basicauth.users={{ grafana_basic_auth }}"
        - "traefik.http.services.grafana.loadbalancer.server.port=3000"
{% endif %}

  # ============================================================================
  # blackbox exporter — probe /api/health over the overlay (JSON → probe_* metrics)
  # ============================================================================
  blackbox:
    image: prom/blackbox-exporter:v0.25.0
    command:
      - "--config.file=/etc/blackbox/blackbox.yml"
    volumes:
      - /opt/lenr-sim/observability/prometheus/blackbox.yml:/etc/blackbox/blackbox.yml:ro
    networks:
      - lenr-sim-network
    deploy:
      mode: replicated
      replicas: 1
{% if require_observability_label | default(false) %}
      placement:
        constraints:
          - node.labels.observability == true
{% endif %}
      resources:
        limits:
          cpus: '0.25'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 32M
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3

  # ============================================================================
  # node_exporter — global, one task per Swarm node (host performance)
  # ============================================================================
  node-exporter:
    image: prom/node-exporter:v1.8.2
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/host/root"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro,rslave
    networks:
      - lenr-sim-network
    deploy:
      mode: global
      resources:
        limits:
          cpus: '0.20'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 32M
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
{% endif %}

# ==============================================================================
# Networks
# ==============================================================================
networks:
  lenr-sim-network:
    external: true

# ==============================================================================
# Volumes
# ==============================================================================
volumes:
{% if postgres_volume_external | default(false) %}
  # Reuse Compose named volume (project/stack lenr-sim → lenr-sim_postgres_data).
  postgres_data:
    external: true
    name: "{{ postgres_volume_name | default('lenr-sim_postgres_data') }}"
{% else %}
  postgres_data:
    driver: local
{% endif %}
{% if observability_enabled | default(true) %}
  prometheus_data:
    driver: local
  grafana_data:
    driver: local
{% endif %}

# ==============================================================================
# Secrets
# ==============================================================================
secrets:
  postgres_password:
    external: true
  api_secret_key:
    external: true
{% if observability_enabled | default(true) %}
  grafana_admin_password:
    external: true
{% endif %}
