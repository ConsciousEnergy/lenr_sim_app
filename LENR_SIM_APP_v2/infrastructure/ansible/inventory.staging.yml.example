# Staging Swarm inventory (v0.3.8) — copy to inventory.staging.yml (do not commit).
# Used by staging-swarm-dry-run.sh remote and deploy.sh staging.
#
# Preferred topology (2×KVM2 + 1×KVM1):
#   - staging-manager-1 = Hostinger KVM1 IP
#     (docs/v0.3.8-beta/KVM1_OPERATOR_WALKTHROUGH.md,
#      docs/v0.3.8-beta/THREE_NODE_SWARM_TOPOLOGY.md)
#   - swarm_workers optional for multi-node staging; at 0.3.9 cutover KVM1
#     becomes a prod worker with app=true + observability=true
#
# Do not list the live Compose share VPS (185.211.4.66) as Swarm manager without
# a written migration plan / CONFIRM_SWARM_0_3_9 cutover window.
# Do NOT use CI KVM2 45.93.100.251 / 2012566 as a Swarm node (untrusted PR code).
#
# Labels use separate keys (Swarm: one value per key). Applied by join-workers.yml:
#   app=true
#   observability=true
# Manual equivalent on manager:
#   docker node update --label-add app=true --label-add observability=true <node_id>

all:
  children:
    swarm_managers:
      hosts:
        staging-manager-1:
          ansible_host: STAGING_MANAGER_IP  # KVM1 IP — never 185.211.4.66 / 45.93.100.251
          ansible_user: root
          ansible_ssh_private_key_file: ~/.ssh/lenr-sim-staging
          # Single-node staging: app + observability on the manager.
          swarm_node_labels:
            - app=true
            - observability=true
    swarm_workers:
      hosts:
        # Optional second staging node. Omit / comment for single-node staging caveat.
        # staging-worker-1:
        #   ansible_host: STAGING_WORKER_IP
        #   ansible_user: root
        #   ansible_ssh_private_key_file: ~/.ssh/lenr-sim-staging
        #   swarm_node_labels:
        #     - app=true
  vars:
    app_domain: "conscious.energy"
    api_subdomain: "api-staging"
    environment: "staging"
    docker_compose_version: "2.24.5"
    traefik_dashboard_auth: true
    traefik_acme_email: "ops@conscious.energy"
    postgres_version: "16"
    postgres_db: "lenr_sim"
    postgres_user: "lenr_app"
    fastapi_workers: 2
    fastapi_log_level: "info"
    # Prometheus + Grafana (see OBSERVABILITY_GRAFANA.md). Staging: labels optional.
    observability_enabled: true
    require_app_label: false
    require_observability_label: false
    grafana_admin_user: "admin"
    grafana_traefik_enabled: false
    # Set grafana_admin_password / grafana_basic_auth via Ansible vault — never commit.
