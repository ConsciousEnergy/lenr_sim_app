{
  "schema": "lenr-campaign-predictions-v1",
  "disclaimer": "These invariants describe LENR_SIM_APP model outputs. They do not prove that LENR occurs in the laboratory. EQ-OPEN-* remain OPEN. A larger campaign does not raise empirical claim tiers.",
  "lenr_proved": false,
  "invariants": [
    {
      "id": "INV-LENR-NOT-PROVED",
      "field": "open_questions.lenr_proved",
      "equals": false
    },
    {
      "id": "INV-OPEN-IDS",
      "field": "open_questions.open_ids",
      "contains": [
        "EQ-OPEN-MEV-01",
        "EQ-OPEN-RAD-01",
        "EQ-OPEN-RATE-01",
        "EQ-OPEN-EC-01",
        "EQ-OPEN-YIELD-01"
      ]
    },
    {
      "id": "INV-Q4-OPEN",
      "field": "open_questions.q_electron_capture.status",
      "equals": "OPEN"
    },
    {
      "id": "INV-Q4-NOT-CLAIMED",
      "field": "open_questions.q_electron_capture.occurrence_claimed",
      "equals": false
    },
    {
      "id": "INV-Q5-OPEN",
      "field": "open_questions.q_integrated_yield.status",
      "equals": "OPEN"
    },
    {
      "id": "INV-Q5-NOT-CLAIMED",
      "field": "open_questions.q_integrated_yield.occurrence_claimed",
      "equals": false
    },
    {
      "id": "INV-Q1-OPEN",
      "field": "open_questions.q_mev_gap.status",
      "equals": "OPEN"
    },
    {
      "id": "INV-Q2-OPEN",
      "field": "open_questions.q_radiation.status",
      "equals": "OPEN"
    },
    {
      "id": "INV-TWO-BODY-LOG10N",
      "when": {
        "open_questions.rate_mode": "two_body"
      },
      "field": "open_questions.q_statistical.n_events_log10_two_body",
      "approx": -40.0,
      "abs_tol": 0.5
    },
    {
      "id": "INV-TWO-BODY-BUDGET",
      "when": {
        "open_questions.rate_mode": "two_body"
      },
      "field": "open_questions.q_statistical.status",
      "equals": "BUDGET_DOES_NOT_CLOSE"
    },
    {
      "id": "INV-ENGINES-NOT-COMBINABLE",
      "field": "open_questions.composition.not_combinable",
      "equals": true
    },
    {
      "id": "INV-CONTRACT-VERSION",
      "field": "contract_version",
      "equals": "v0.3.9-beta-science-gate-1"
    }
  ]
}
